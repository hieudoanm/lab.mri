Project MRILab {
  database_type: 'PostgreSQL'
  Note: 'ER diagram for the MRI Lab application schema. Kept in sync with the versioned SQL migrations under packages/backend/app/db/migrations/. Lifecycle statuses are modelled as DBML enums that map to constrained TEXT values with CHECK constraints in PostgreSQL. Large MRI voxel arrays live in S3-compatible object storage and are never stored in relational columns.'
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

Enum project_role {
  owner
  editor
  viewer
}

Enum project_visibility {
  private
  shared
  public
}

Enum dataset_source_type {
  upload
  import
  sample
}

Enum upload_session_status {
  pending
  completed
  expired
  aborted
}

Enum run_status {
  queued
  running
  succeeded
  failed
  cancelled
}

Enum outbox_status {
  pending
  dispatched
  failed
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

Table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email text [not null, note: 'Contact information, not the permanent identity key; case-insensitive lookup']
  display_name text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (email) [unique, name: 'uq_users_email']
  }

  Note: 'Application user identity. Passwords are never stored; an external OIDC provider owns the authoritative identity record.'
}

Table projects {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  owner_id uuid [not null]
  name text [not null, note: 'Required, non-empty']
  description text
  visibility project_visibility [not null, default: 'private']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    (owner_id, created_at) [name: 'ix_projects_owner_created_at', note: 'created_at is DESC']
    (visibility, created_at) [name: 'ix_projects_visibility_created_at', note: 'created_at is DESC']
  }

  Note: 'Top-level workspace. The owner is also represented as an owner row in project_members; the last-owner invariant requires transactional application logic.'
}

Table project_members {
  project_id uuid [not null]
  user_id uuid [not null]
  role project_role [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, user_id) [unique, name: 'uq_project_members_project_user']
    (user_id) [name: 'ix_project_members_user_id']
  }

  Note: 'Primary key is (project_id, user_id). Role changes and membership removals must generate audit events.'
}

// ---------------------------------------------------------------------------
// Imaging data
// ---------------------------------------------------------------------------

Table datasets {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  name text [not null, note: 'Required, non-empty; not unique within a project']
  source_type dataset_source_type [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  archived_at timestamptz

  indexes {
    (project_id, created_at) [name: 'ix_datasets_project_created_at', note: 'created_at is DESC']
    (project_id, id) [unique, name: 'uq_datasets_project_id_id', note: 'Supports composite project-scoped foreign keys']
  }

  Note: 'Logical dataset identity within a project, deliberately separated from its immutable versions. A dataset holds no voxel data itself.'
}

Table dataset_versions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  dataset_id uuid [not null]
  version text [not null, note: 'Monotonic version label, e.g. "1", "2"; must be non-empty']
  manifest jsonb [not null, default: `'{}'::jsonb`, note: 'Validated snapshot manifest: dimensions, voxel spacing, orientation, data type, affine, file roles']
  status text [not null, default: 'created', note: 'One of created, validating, ready, failed']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (dataset_id, version) [unique, name: 'uq_dataset_versions_dataset_version']
    (dataset_id, created_at) [name: 'ix_dataset_versions_dataset_created_at', note: 'created_at is DESC']
    (dataset_id, id) [unique, name: 'uq_dataset_versions_dataset_id_id', note: 'Supports composite project-scoped foreign keys']
  }

  Note: 'Immutable snapshots of a dataset. A ready version must reference at least one file_assets row with a valid SHA-256 checksum and must not change thereafter.'
}

Table file_assets {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  dataset_version_id uuid [not null]
  object_key text [not null, note: 'Server-generated private object key; never a permanent signed URL']
  checksum text [not null, note: 'SHA-256 in the documented sha256:... representation']
  size_bytes bigint [not null, note: 'Must be non-negative']
  media_type text [not null, note: 'e.g. application/gzip, application/octet-stream']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (object_key) [unique, name: 'uq_file_assets_object_key']
    (dataset_version_id) [name: 'ix_file_assets_dataset_version_id']
  }

  Note: 'Individual files belonging to a dataset version. Voxel content lives in object storage; only metadata and the object key are stored here.'
}

Table upload_sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  dataset_id uuid [not null]
  project_id uuid [not null, note: 'Scopes access checks; must match the owning project of dataset_id']
  status upload_session_status [not null, default: 'pending']
  expected_size_bytes bigint [note: 'Non-negative when present']
  checksum_sha256 text [note: 'Client-declared SHA-256 for verification']
  expires_at timestamptz [not null, note: 'Authorisation expiry; a session past this time cannot be completed']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (dataset_id, created_at) [name: 'ix_upload_sessions_dataset_created_at', note: 'created_at is DESC']
    (status, expires_at) [name: 'ix_upload_sessions_status_expires_at', note: 'For cleanup workers']
  }

  Note: 'Resumable upload lifecycle for .nii and .nii.gz volumes. Finalisation is idempotent and yields at most one dataset version.'
}

// ---------------------------------------------------------------------------
// Pipelines and runs
// ---------------------------------------------------------------------------

Table pipelines {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null]
  name text [not null, note: 'Required, non-empty; not unique within a project']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, created_at) [name: 'ix_pipelines_project_created_at', note: 'created_at is DESC']
    (project_id, id) [unique, name: 'uq_pipelines_project_id_id', note: 'Supports composite project-scoped foreign keys']
  }

  Note: 'Logical identity of an analysis workflow within a project.'
}

Table pipeline_versions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  pipeline_id uuid [not null]
  version text [not null, note: 'Semantic version label, e.g. 1.0.0']
  definition jsonb [not null, note: 'Validated workflow definition and parameter schema']
  image_digest text [not null, note: 'Immutable OCI image digest (sha256:...); not a mutable tag']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (pipeline_id, version) [unique, name: 'uq_pipeline_versions_pipeline_version']
  }

  Note: 'Immutable, versioned pipeline definitions. Edits create a new version.'
}

Table experiment_runs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  pipeline_version_id uuid [not null]
  dataset_version_id uuid [not null]
  status run_status [not null, default: 'queued']
  parameters jsonb [not null, default: `'{}'::jsonb`, note: 'Validated against the pipeline version parameter schema']
  error text [note: 'Sanitised failure summary']
  started_at timestamptz
  finished_at timestamptz [note: 'Populated when a terminal state is reached']
  created_at timestamptz [not null, default: `now()`, note: 'Submission time']

  indexes {
    (status, created_at) [name: 'ix_experiment_runs_status_created_at', note: 'created_at is DESC; for the work queue']
    (dataset_version_id, created_at) [name: 'ix_experiment_runs_dataset_version_created_at', note: 'created_at is DESC']
    (pipeline_version_id, created_at) [name: 'ix_experiment_runs_pipeline_version_created_at', note: 'created_at is DESC']
  }

  Note: 'Durable execution state for a submitted pipeline version over a dataset version. Pipeline version, dataset version, and the owning project must be consistent. Job submission is deduplicated with idempotency_keys.'
}

// ---------------------------------------------------------------------------
// Outputs and provenance
// ---------------------------------------------------------------------------

Table artifacts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  run_id uuid [not null]
  object_key text [not null, note: 'Server-generated private object key; globally unique']
  checksum text [not null, note: 'SHA-256 in the documented sha256:... representation']
  media_type text [not null, note: 'e.g. image/nifti, text/csv, text/markdown']
  metadata jsonb [not null, default: `'{}'::jsonb`, note: 'Validated supplementary metadata; must not contain raw voxel arrays']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (object_key) [unique, name: 'uq_artifacts_object_key']
    (run_id) [name: 'ix_artifacts_run_id']
  }

  Note: 'Output files and reports produced by a run. Artifact content lives in object storage.'
}

Table annotations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  project_id uuid [not null, note: 'Scopes access checks; must match the owning project of dataset_version_id']
  dataset_version_id uuid [not null]
  coordinate_space text [not null, note: 'Explicit space, e.g. voxel, ras_mm, mni152']
  coordinates jsonb [not null, note: 'Coordinates interpreted in coordinate_space; never persist three unlabelled numbers']
  body text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (dataset_version_id, created_at) [name: 'ix_annotations_dataset_version_created_at', note: 'created_at is DESC']
    (project_id, created_at) [name: 'ix_annotations_project_created_at', note: 'created_at is DESC']
  }

  Note: 'Spatial notes and markers attached to a dataset version. The coordinate space must always be recorded with the coordinates.'
}

Table usage_records {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  run_id uuid [note: 'Nullable; usage may accrue outside a run']
  resource_type text [not null, note: 'e.g. cpu_seconds, storage_bytes, runs']
  quantity bigint [not null, note: 'Non-negative consumed quantity']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'ix_usage_records_user_created_at', note: 'created_at is DESC']
    (run_id) [name: 'ix_usage_records_run_id']
  }

  Note: 'Append-only accounting of resource consumption for quota and cost reporting.'
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

Table audit_events {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  actor_id uuid [note: 'Nullable for system actions']
  action text [not null, note: 'e.g. run.submitted, project.created']
  resource_type text [not null, note: 'Affected resource type']
  resource_id uuid [note: 'Affected resource identifier']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (resource_type, resource_id, created_at) [name: 'ix_audit_events_resource_created_at', note: 'created_at is DESC']
    (actor_id, created_at) [name: 'ix_audit_events_actor_created_at', note: 'created_at is DESC']
  }

  Note: 'Append-only audit trail. Never store tokens, signed URLs, or raw voxel data. Where integrity requires it, persist the event in the same transaction as the related change.'
}

Table outbox_events {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  event_type text [not null]
  payload jsonb [not null, note: 'Minimal validated dispatch payload; must not contain secrets or raw voxel arrays']
  status outbox_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  dispatched_at timestamptz [note: 'Populated exactly when the event reaches dispatched']

  indexes {
    (status, created_at) [name: 'ix_outbox_events_status_created_at', note: 'For the dispatcher']
    (event_type, created_at) [name: 'ix_outbox_events_event_type_created_at', note: 'created_at is DESC']
  }

  Note: 'Reliable publication of background work. A dispatcher may claim rows with FOR UPDATE SKIP LOCKED; consumers must be idempotent.'
}

Table idempotency_keys {
  key text [pk, not null, note: 'Client-provided idempotency key']
  user_id uuid [not null]
  request_hash text [not null, note: 'Hash of canonicalised request data; must be stable for equivalent requests']
  response jsonb [note: 'Safe stored response representation; never store sensitive fields']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, key) [unique, name: 'uq_idempotency_keys_user_key', note: 'Scopes keys per user and prevents cross-user collisions']
  }

  Note: 'Durable record of state-changing API requests that require deduplication, especially run submission and upload finalisation. Reuse of a key with a different request_hash must be rejected.'
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

Ref: projects.owner_id > users.id [delete: restrict]
Ref: project_members.project_id > projects.id [delete: cascade]
Ref: project_members.user_id > users.id [delete: cascade]

Ref: datasets.project_id > projects.id [delete: restrict]
Ref: dataset_versions.dataset_id > datasets.id [delete: restrict]
Ref: file_assets.dataset_version_id > dataset_versions.id [delete: cascade]

Ref: upload_sessions.(project_id, dataset_id) > datasets.(project_id, id) [delete: restrict, note: 'Cross-project integrity: the session project must match the dataset project']
Ref: upload_sessions.dataset_id > datasets.id [delete: restrict]

Ref: pipelines.project_id > projects.id [delete: restrict]
Ref: pipeline_versions.pipeline_id > pipelines.id [delete: restrict]

Ref: experiment_runs.pipeline_version_id > pipeline_versions.id [delete: restrict]
Ref: experiment_runs.dataset_version_id > dataset_versions.id [delete: restrict]

Ref: artifacts.run_id > experiment_runs.id [delete: cascade]

Ref: annotations.dataset_version_id > dataset_versions.id [delete: cascade]
Ref: annotations.project_id > projects.id [delete: restrict, note: 'Cross-project integrity: annotations.project_id must resolve through datasets to the dataset version project']

Ref: usage_records.user_id > users.id [delete: restrict]
Ref: usage_records.run_id > experiment_runs.id [delete: set null]

Ref: audit_events.actor_id > users.id [delete: set null]

Ref: idempotency_keys.user_id > users.id [delete: cascade]
